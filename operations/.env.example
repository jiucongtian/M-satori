DATABASE_URL=postgresql://user:password@postgres:5432/satori
OPERATIONS_JWT_SECRET=replace-with-at-least-32-random-characters
# 多账号配置。每个 passwordSha256 都是对应强密码的 SHA-256 十六进制摘要。
OPERATIONS_ACCOUNTS_JSON=[{"account":"fred","passwordSha256":"replace-with-sha256-hex-not-plaintext"},{"account":"operator2","passwordSha256":"replace-with-sha256-hex-not-plaintext"}]
# 旧版单账号配置仍兼容一个发布周期；配置 OPERATIONS_ACCOUNTS_JSON 后以下两项会被忽略。
OPERATIONS_BOOTSTRAP_USER=fred
OPERATIONS_BOOTSTRAP_PASSWORD_SHA256=replace-with-sha256-hex-not-plaintext
OPERATIONS_CORS_ORIGIN=https://operations.test.shenxinyou.com
SATORI_API_BASE=https://test-satori.shenxinyou.com
# 高风险写操作启用后再配置短期运营服务令牌；未配置时平台保持只读。
SATORI_OPERATOR_TOKEN=
PORT=3210
