# Satori 后端部署环境变量模板。
# 只包含“随部署环境变化”的配置；业务、安全和可靠性规则见
# packages/infrastructure/src/config/runtime-policy.ts。
# 可选变量在未启用对应能力时必须整行省略，不能保留空值。

# 用途：选择应用运行模式。
# 取值：development | test | production。
# 影响：决定短信实现和生产安全校验；正式环境必须使用 production。
NODE_ENV=development

# 用途：设置 API 在容器或主机内监听的网络地址。
# 取值：合法 IPv4、IPv6 或主机名，例如 0.0.0.0。
# 影响：错误值会导致 API 无法监听或只能从部分网络访问。
HOST=0.0.0.0

# 用途：设置 API 进程监听端口。
# 取值：1–65535 的整数。
# 影响：必须与 Docker 端口映射和 Nginx 上游端口一致。
PORT=3000

# 用途：提供 PostgreSQL 连接地址。
# 取值：合法的 postgresql:// URL；正式环境必须由密钥系统注入。
# 影响：API、Worker、迁移和 Seed 都依赖它；错误会导致服务无法就绪。
DATABASE_URL=postgresql://satori:satori@localhost:5432/satori

# 用途：限制单个 API/Worker 进程的 PostgreSQL 连接池上限。
# 取值：大于 0 的整数。
# 影响：过小会降低吞吐，过大会耗尽数据库连接数。
DATABASE_POOL_MAX=10

# 用途：提供 Redis 连接地址。
# 取值：合法的 redis:// 或 rediss:// URL。
# 影响：生成队列、Outbox 投递和短信限流依赖它；错误会阻止服务正常工作。
REDIS_URL=redis://localhost:6379

# 用途：隔离 BullMQ 队列和短信限流使用的 Redis Key。
# 取值：非空字符串；不同环境应使用不同前缀。
# 影响：前缀冲突会导致多个环境互相消费任务或共享限流计数。
QUEUE_PREFIX=satori

# 用途：设置单个 Worker 同时处理的生成任务数量。
# 取值：大于 0 的整数。
# 影响：提高会增加吞吐，也会增加数据库、Redis 和 Aqua 的并发压力。
QUEUE_CONCURRENCY=5

# 用途：设置生成任务失联判断和单次 Worker 执行超时。
# 取值：大于 0 的毫秒整数。
# 影响：过短会误杀慢任务，过长会延迟失败恢复和重试。
QUEUE_JOB_TIMEOUT_MS=360000

# 用途：配置允许携带 Cookie 调用 API 的浏览器 Origin 白名单。
# 取值：逗号分隔的完整 Origin，禁止 *，例如 http://localhost:3001。
# 影响：缺失前端域名会触发浏览器 CORS 拒绝；过宽会扩大跨站请求风险。
CORS_ORIGINS=http://localhost:3001

# 用途：签名分页游标，防止客户端伪造翻页位置。
# 取值：至少 16 个字符的随机密钥；正式环境不得使用示例值。
# 影响：轮换后旧分页游标失效；泄露会允许伪造游标。
CURSOR_SIGNING_SECRET=development-cursor-secret

# 用途：对手机号、设备、IP、验证码和 Refresh Token 派生值执行 HMAC。
# 取值：至少 32 个字符的随机密钥；正式环境必须由密钥系统注入。
# 影响：错误轮换会使既有身份、验证码和 Session 无法匹配。
AUTH_HMAC_SECRET=development-auth-hmac-secret-0001

# 用途：签发并验证 Access Token。
# 取值：至少 32 个字符的随机密钥；正式环境必须由密钥系统注入。
# 影响：轮换会使旧 Access Token 失效；泄露会危及身份认证。
ACCESS_TOKEN_SECRET=development-access-token-secret-01

# 用途：加密数据库中的手机号等敏感字段。
# 取值：恰好 64 位十六进制字符，对应 32 字节密钥。
# 影响：错误轮换会导致历史密文无法解密，必须采用受控双读单写方案。
DATA_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# 用途：控制 Refresh Token Cookie 是否只通过 HTTPS 发送。
# 取值：true | false；production 强制为 true。
# 影响：false 会降低 Cookie 传输安全性，true 要求调用方使用 HTTPS。
COOKIE_SECURE=false

# 用途：提供正式短信供应商 HTTP 接口地址。
# 取值：合法的 https:// URL；development/test 可整行省略，production 必填。
# 影响：启用正式短信时缺失或错误会导致验证码发送失败。
# SMS_GATEWAY_URL=https://sms.example.com/verification-codes

# 用途：认证正式短信供应商请求。
# 取值：至少 16 个字符的供应商密钥；development/test 可整行省略，production 必填。
# 影响：缺失、错误或泄露会影响短信发送与供应商账户安全。
# SMS_GATEWAY_API_KEY=replace-with-server-secret

# 用途：限制单次短信供应商 HTTP 请求等待时间。
# 取值：大于 0 的毫秒整数。
# 影响：过短会增加误超时，过长会占用 API 请求资源。
SMS_GATEWAY_TIMEOUT_MS=5000

# 用途：选择完整每日指引的内容生成器。
# 取值：STUB | AQUA；production 强制使用 AQUA。
# 影响：STUB 生成确定性测试内容，AQUA 调用外部 Workflow 并消耗外部资源。
DAILY_INSIGHT_GENERATOR=STUB

# 用途：提供完整每日指引和 Aqua 版 PROFILE-11 使用的 Aqua AI 地址。
# 取值：合法的 https:// URL；仅在对应生成器选择 AQUA 时必填。
# 影响：错误地址会使每日指引或 PROFILE-11 生成失败。
# AQUA_AI_BASE_URL=https://aqua.example.com

# 用途：认证完整每日指引和 Aqua 版 PROFILE-11 的 Aqua AI 请求。
# 取值：至少 20 个字符的 Service Key；仅在对应生成器选择 AQUA 时必填。
# 影响：缺失、错误或泄露会影响内容生成和 Aqua 租户安全。
# AQUA_AI_SERVICE_KEY=replace-with-server-secret

# 用途：指定完整每日指引调用的 Aqua Workflow。
# 取值：非空 Workflow ID。
# 影响：修改会切换内容生成逻辑和知识版本，必须完成内容与契约验收。
AQUA_AI_WORKFLOW_ID=daily-insight

# 用途：将完整每日指引固定到特定 Aqua Workflow 版本。
# 取值：非空版本字符串；省略时使用 Aqua 当前激活版本。
# 影响：固定版本便于回滚和复现，省略则会随 Aqua 激活版本变化。
# AQUA_AI_WORKFLOW_VERSION=1.0.0

# 用途：启用或关闭 PROFILE-11 初识报告生成能力。
# 取值：true | false。
# 影响：false 时生成器不注册，相关生成请求无法产出初识报告。
PROFILE_FIRST_LOOK_ENABLED=false

# 用途：选择 PROFILE-11 初识报告生成器。
# 取值：LOCAL | AQUA。
# 影响：LOCAL 使用本地确定性知识，AQUA 调用外部服务并需要 Aqua AI 凭据。
PROFILE_FIRST_LOOK_GENERATOR=LOCAL

# 用途：限制 PROFILE-11 外部生成和任务失联判断时间。
# 取值：大于 0 的毫秒整数。
# 影响：过短会误判慢任务失败，过长会延迟故障恢复。
PROFILE_FIRST_LOOK_TIMEOUT_MS=300000

# 用途：启用或关闭首页 Aqua 每日能量摘要。
# 取值：true | false。
# 影响：true 时必须配置 Aqua 租户地址和密钥；false 时首页使用降级内容。
HOME_ENERGY_SUMMARY_ENABLED=false

# 用途：限制单次首页能量摘要 Aqua 请求时间。
# 取值：大于 0 的毫秒整数。
# 影响：过短会增加误超时，过长会拖慢首页摘要生成和缓存填充。
HOME_ENERGY_SUMMARY_TIMEOUT_MS=15000

# 用途：设置首页能量摘要调用的最大尝试次数。
# 取值：1–3 的整数。
# 影响：提高可增强短暂故障恢复，也会增加 Aqua 调用量和响应时间。
HOME_ENERGY_SUMMARY_MAX_ATTEMPTS=2

# 用途：设置首页能量摘要重试之间的基础等待时间。
# 取值：大于等于 0 的毫秒整数。
# 影响：过短会快速冲击外部服务，过长会延迟摘要生成。
HOME_ENERGY_SUMMARY_RETRY_BACKOFF_MS=250

# 用途：启用或关闭首页能量摘要后台预热。
# 取值：true | false；只能在 HOME_ENERGY_SUMMARY_ENABLED=true 时开启。
# 影响：开启可降低用户首次访问延迟，但会提前产生 Aqua 调用和缓存写入。
HOME_ENERGY_PREWARM_ENABLED=false

# 用途：选择首页能量摘要预热的受控参数组合。
# 取值：CONSERVATIVE | NORMAL。
# 影响：CONSERVATIVE 使用更低并发和更长周期；NORMAL 为当前测试环境基线。
HOME_ENERGY_PREWARM_PROFILE=NORMAL

# 用途：提供首页能量摘要使用的 Aqua 租户接口地址。
# 取值：合法的 https:// URL；HOME_ENERGY_SUMMARY_ENABLED=true 时必填。
# 影响：错误地址会使首页摘要生成和预热失败。
# AQUA_BASE_URL=https://aqua.example.com

# 用途：认证首页能量摘要使用的 Aqua 租户请求。
# 取值：至少 20 个字符的 Tenant Service Key；启用首页摘要时必填。
# 影响：缺失、错误或泄露会影响摘要生成和 Aqua 租户安全。
# AQUA_TENANT_SERVICE_KEY=replace-with-server-secret
