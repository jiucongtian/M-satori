# Satori 后端部署环境变量模板。
# 只包含“随部署环境变化”的配置；业务、安全和可靠性规则见
# packages/infrastructure/src/config/runtime-policy.ts。
# 可选变量在未启用对应能力时必须整行省略，不能保留空值。

# 用途：设置 API 在容器或主机内监听的网络地址。
# 取值：合法 IPv4、IPv6 或主机名，例如 0.0.0.0。
# 影响：错误值会导致 API 无法监听或只能从部分网络访问。
HOST=0.0.0.0

# 用途：设置 API 进程监听端口。
# 取值：1–65535 的整数。
# 影响：必须与 Docker 端口映射和 Nginx 上游端口一致。
PORT=3000

# 用途：提供 PostgreSQL 连接地址。
# 取值：合法的 postgresql:// URL；正式环境必须由密钥系统注入。
# 影响：API、Worker、迁移和 Seed 都依赖它；错误会导致服务无法就绪。
DATABASE_URL=postgresql://satori:satori@localhost:5432/satori

# 用途：限制单个 API/Worker 进程的 PostgreSQL 连接池上限。
# 取值：大于 0 的整数。
# 影响：过小会降低吞吐，过大会耗尽数据库连接数。
DATABASE_POOL_MAX=10

# 用途：提供 Redis 连接地址。
# 取值：合法的 redis:// 或 rediss:// URL。
# 影响：生成队列、Outbox 投递和短信限流依赖它；错误会阻止服务正常工作。
REDIS_URL=redis://localhost:6379

# 用途：隔离 BullMQ 队列和短信限流使用的 Redis Key。
# 取值：非空字符串；不同环境应使用不同前缀。
# 影响：前缀冲突会导致多个环境互相消费任务或共享限流计数。
QUEUE_PREFIX=satori

# 用途：设置单个 Worker 同时处理的生成任务数量。
# 取值：大于 0 的整数。
# 影响：提高会增加吞吐，也会增加数据库、Redis 和 Aqua 的并发压力。
QUEUE_CONCURRENCY=5

# 用途：设置生成任务失联判断和单次 Worker 执行超时。
# 取值：大于 0 的毫秒整数。
# 影响：过短会误杀慢任务，过长会延迟失败恢复和重试。
QUEUE_JOB_TIMEOUT_MS=360000

# 用途：配置允许携带 Cookie 调用 API 的浏览器 Origin 白名单。
# 取值：逗号分隔的完整 Origin，禁止 *，例如 http://localhost:3001。
# 影响：缺失前端域名会触发浏览器 CORS 拒绝；过宽会扩大跨站请求风险。
CORS_ORIGINS=http://localhost:3001

# 用途：签名分页游标，防止客户端伪造翻页位置。
# 取值：至少 16 个字符的随机密钥；正式环境不得使用示例值。
# 影响：轮换后旧分页游标失效；泄露会允许伪造游标。
CURSOR_SIGNING_SECRET=development-cursor-secret

# 用途：控制智慧种子查询从旧总余额、影子比对或新批次投影读取。
# 取值：LEGACY | SHADOW | BATCH；完成迁移对账前不得切换为 BATCH。
# 影响：SHADOW 仅记录差异并返回旧结果，BATCH 以新批次投影为查询事实。
SEED_BATCH_READ_MODE=LEGACY

# 用途：控制每日指引继续使用旧种子结算、仅影子比较新决策，或切换统一消费意图。
# 取值：LEGACY | SHADOW | UNIFIED；完成影子差异核对前不得切换为 UNIFIED。
# 影响：SHADOW 不改变实际扣减，UNIFIED 由固定优先级消费端口负责预留和核销。
DAILY_INSIGHT_CONSUMPTION_MODE=UNIFIED

# 用途：灰度开放 R1.1 商品目录与服务端报价。
# 取值：true | false；发布顺序第一步开启。
# 影响：false 时商品、会员方案和新报价接口返回暂不可用。
R11_CATALOG_PRICING_ENABLED=false

# 用途：灰度开放 R1.1 固定优先级权益解析与消费意图。
# 取值：true | false；商品报价验证后开启。
# 影响：false 时不创建新的 resolution/intent，既有后台结算和对账继续执行。
R11_ENTITLEMENT_CONSUMPTION_ENABLED=false

# 用途：控制 R1.1 新人民币订单与新支付尝试入口。
# 取值：true | false；已有权益核销验证后开启。
# 影响：false 时停止创建新订单/支付尝试，已支付订单、回调、Worker 和补偿不受影响。
R11_NEW_ORDERS_ENABLED=false

# 用途：灰度开放会员方案购买与续费入口。
# 取值：true | false；权益包支付验证后开启。
# 影响：false 时会员方案目录不可用，既有会员查询、到期和权益维护继续执行。
R11_MEMBERSHIP_ENABLED=false

# 用途：灰度开放普通商品未使用权益退款入口。
# 取值：true | false；会员开通续费验证后开启。
# 影响：false 时不接受新的普通退款报价/申请，既有退款 Worker 继续恢复。
R11_ORDINARY_REFUNDS_ENABLED=false

# 用途：灰度开放替换式会员升级入口。
# 取值：true | false；整个灰度序列最后开启。
# 影响：false 时不接受新的升级登记，既有升级 Saga、交付和补偿继续执行。
R11_MEMBERSHIP_UPGRADES_ENABLED=false

# 用途：控制用户行为埋点批量接收与落库；关闭时接口仍返回 202，但不保存事件。
# 取值：true | false；本地默认关闭，测试环境验证后按环境开启。
# 影响：埋点开关不得影响任何用户业务流程。
ANALYTICS_INGESTION_ENABLED=false

# 用途：对手机号、设备、IP、验证码和 Refresh Token 派生值执行 HMAC。
# 取值：至少 32 个字符的随机密钥；正式环境必须由密钥系统注入。
# 影响：错误轮换会使既有身份、验证码和 Session 无法匹配。
AUTH_HMAC_SECRET=development-auth-hmac-secret-0001

# 用途：签发并验证 Access Token。
# 取值：至少 32 个字符的随机密钥；正式环境必须由密钥系统注入。
# 影响：轮换会使旧 Access Token 失效；泄露会危及身份认证。
ACCESS_TOKEN_SECRET=development-access-token-secret-01

# 用途：加密数据库中的手机号等敏感字段。
# 取值：恰好 64 位十六进制字符，对应 32 字节密钥。
# 影响：错误轮换会导致历史密文无法解密，必须采用受控双读单写方案。
DATA_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# 用途：控制 Refresh Token Cookie 是否只通过 HTTPS 发送。
# 取值：true | false；production 强制为 true。
# 影响：false 会降低 Cookie 传输安全性，true 要求调用方使用 HTTPS。
COOKIE_SECURE=false

# 用途：选择验证码是使用固定测试码，还是通过短信供应商真实发送。
# 取值：FIXED_CODE | GATEWAY；测试环境短信未接通前使用 FIXED_CODE，生产使用 GATEWAY。
# 影响：FIXED_CODE 不发送短信并使用服务端固定测试码；GATEWAY 生成随机验证码并要求配置短信供应商。
SMS_DELIVERY_MODE=FIXED_CODE

# 用途：提供正式短信供应商 HTTP 接口地址。
# 取值：合法的 https:// URL；development/test 可整行省略，production 必填。
# 影响：启用正式短信时缺失或错误会导致验证码发送失败。
# SMS_GATEWAY_URL=https://sms.example.com/verification-codes

# 用途：认证正式短信供应商请求。
# 取值：至少 16 个字符的供应商密钥；development/test 可整行省略，production 必填。
# 影响：缺失、错误或泄露会影响短信发送与供应商账户安全。
# SMS_GATEWAY_API_KEY=replace-with-server-secret

# 用途：限制单次短信供应商 HTTP 请求等待时间。
# 取值：大于 0 的毫秒整数。
# 影响：过短会增加误超时，过长会占用 API 请求资源。
SMS_GATEWAY_TIMEOUT_MS=5000

# 用途：提供 Satori 调用同一 Aqua 租户全部 Workflow 的统一服务地址。
# 取值：合法的 https:// URL，所有运行环境必填。
# 影响：错误地址会使完整每日指引、首页能量摘要和抽卡问事全部无法生成。
AQUA_BASE_URL=https://aqua.example.com

# 用途：认证 Satori 对同一 Aqua 租户全部 Workflow 的统一请求。
# 取值：至少 20 个字符的 Service Key，所有运行环境必填。
# 影响：缺失、错误或泄露会影响全部 Aqua 内容生成（包括抽卡问事）和租户安全。
AQUA_SERVICE_KEY=replace-with-server-secret

# 用途：选择人民币订单支付适配器。
# 取值：FAKE | WECHAT_PAY；测试可使用 FAKE，真实环境使用 WECHAT_PAY。
# 影响：选择 WECHAT_PAY 时所有微信支付凭据都必须完整注入。
PAYMENT_PROVIDER_MODE=FAKE

# 用途：控制 Fake 支付创建后的确定性结果，便于在不连接真实支付渠道时联调整条业务链路。
# 取值：PENDING | SUCCEEDED；本地故障演练可用 PENDING，测试环境闭环验收可用 SUCCEEDED。
# 影响：SUCCEEDED 会立即写入支付成功事实并触发交付，只允许在 PAYMENT_PROVIDER_MODE=FAKE 时使用。
FAKE_PAYMENT_RESULT=PENDING

# 用途：标识微信支付商户号。
# 取值：微信支付平台分配的商户号，仅通过部署 Secret 注入。
# 影响：缺失或错误会阻止真实支付适配器启动。
# WECHAT_MERCHANT_ID=merchant-id

# 用途：标识调起微信支付的应用。
# 取值：已绑定商户号的微信 AppID，仅通过部署 Secret 注入。
# 影响：错误 AppID 会导致客户端支付参数无效。
# WECHAT_APP_ID=wechat-app-id

# 用途：由服务端通过公众号网页授权接口换取付款用户 OpenID。
# 取值：公众号 AppSecret，仅通过部署 Secret 注入，绝不能下发到浏览器。
# 影响：缺失、错误或泄露会阻止 JSAPI 支付用户授权并危及公众号接口安全。
# WECHAT_APP_SECRET=wechat-app-secret

# 用途：限定微信网页授权回调和结账页返回地址的公网 Origin。
# 取值：不带路径的 HTTPS Origin，例如 https://test-satori.shenxinyou.com。
# 影响：必须与公众号网页授权域名一致；错误值会导致 OAuth 回调失败或被安全校验拒绝。
# WECHAT_OAUTH_REDIRECT_ORIGIN=https://example.com

# 用途：解密微信支付通知资源。
# 取值：恰好 32 个字符的 APIv3 密钥，仅通过部署 Secret 注入。
# 影响：缺失、错误或泄露会影响回调验真和资金安全。
# WECHAT_API_V3_KEY=32-character-api-v3-secret-key

# 用途：签署发送给微信支付的商户 API 请求。
# 取值：Base64 编码的 PEM 商户私钥，仅通过部署 Secret 注入。
# 影响：缺失、错误或泄露会阻止支付、查单和退款调用。
# WECHAT_MERCHANT_PRIVATE_KEY_BASE64=base64-encoded-pem-private-key

# 用途：构造微信 API v3 Authorization 中的商户 API 证书序列号。
# 取值：商户 API 证书的十六进制序列号，仅通过部署 Secret 注入。
# 影响：缺失或错误会导致微信拒绝下单、查单和退款请求。
# WECHAT_MERCHANT_SERIAL_NO=merchant-certificate-serial-no

# 用途：验证微信支付平台回调签名。
# 取值：Base64 编码的 PEM 平台公钥，仅通过部署 Secret 注入。
# 影响：缺失或错误会拒绝合法回调，泄露不会授予签名能力但仍应受控。
# WECHAT_PLATFORM_PUBLIC_KEY_BASE64=base64-encoded-pem-public-key

# 用途：绑定当前微信支付公钥，校验应答和回调的 Wechatpay-Serial。
# 取值：微信支付公钥 ID（通常以 PUB_KEY_ID_ 开头），仅通过部署 Secret 注入。
# 影响：缺失或错误会拒绝所有无法匹配当前公钥的应答和回调。
# WECHAT_PUBLIC_KEY_ID=PUB_KEY_ID_xxx

# 用途：声明微信支付异步结果通知地址。
# 取值：公网可访问的精确 HTTPS 回调 URL。
# 影响：配置错误会导致支付结果无法及时到达系统。
# WECHAT_NOTIFY_URL=https://example.com/api/v1/internal/payment-webhooks/wechat

# 用途：限制应用只接受来自可信反向代理的微信回调连接。
# 取值：可信代理 IP 的逗号分隔列表，生产环境按实际网关网络设置。
# 影响：遗漏真实代理会拒绝回调，放宽到非可信来源会扩大攻击面。
WECHAT_WEBHOOK_ALLOWED_IPS=127.0.0.1,::1
