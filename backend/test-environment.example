# Satori 测试和压测专用变量；不得复制到生产环境文件。

# 用途：控制确定性每日指引 Stub 的测试行为。
# 取值：SUCCESS | FAILURE | DELAY。
# 影响：FAILURE 模拟生成失败，DELAY 配合延迟值模拟慢任务和超时。
DAILY_INSIGHT_STUB_MODE=SUCCESS

# 用途：设置确定性每日指引 Stub 的人工延迟。
# 取值：大于等于 0 的毫秒整数，仅在 DAILY_INSIGHT_STUB_MODE=DELAY 时生效。
# 影响：超过 QUEUE_JOB_TIMEOUT_MS 时可验证超时、重试和种子释放路径。
DAILY_INSIGHT_STUB_DELAY_MS=0

# 用途：控制测试套件是否运行依赖真实 PostgreSQL/Redis 的用例。
# 取值：true | false。
# 影响：true 需要隔离测试数据库和 Redis，禁止连接生产资源。
RUN_DATABASE_TESTS=false

# 用途：设置负载冒烟脚本请求的测试环境地址。
# 取值：合法的 https:// 测试环境 URL。
# 影响：错误目标会使负载测试失败；禁止指向生产环境。
LOAD_TEST_URL=https://test.example.com

# 用途：提供负载测试专用账号。
# 取值：仅限隔离测试账号的手机号；不得使用真实用户或生产账号。
# 影响：脚本会用该账号登录并产生测试业务数据。
LOAD_TEST_PHONE=replace-with-test-account

# 用途：提供负载测试专用验证码。
# 取值：测试环境允许的 6 位验证码；不得填写生产验证码。
# 影响：错误值会导致负载脚本无法建立 Session。
LOAD_TEST_OTP=replace-with-test-code

# 用途：设置负载冒烟脚本发送的总请求数。
# 取值：大于 0 的整数，默认 40。
# 影响：提高会增加测试环境 API、数据库和外部服务负载。
LOAD_REQUESTS=40

# 用途：设置负载冒烟脚本的并发请求数。
# 取值：大于 0 且不超过总请求数的整数，默认 8。
# 影响：提高会增加瞬时负载，应与测试环境容量匹配。
LOAD_CONCURRENCY=8
