{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "NEXT_PUBLIC_SHOW_PAGE_LABELS=true WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --port 3001",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:static": "SATORI_STATIC_EXPORT=true next build",
    "build:test:static": "NEXT_PUBLIC_SHOW_PAGE_LABELS=true SATORI_STATIC_EXPORT=true next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "api:generate": "openapi-typescript ../backend/openapi/openapi.yaml -o src/api/contracts/generated.ts",
    "api:lint": "redocly lint ../backend/openapi/openapi.yaml --extends=spec",
    "api:check": "npm run api:lint && npm run api:generate && git diff --exit-code -- src/api/contracts/generated.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "5.2.7",
    "@fontsource/noto-serif-sc": "5.2.7",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@redocly/cli": "^2.46.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "openapi-typescript": "^7.13.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
